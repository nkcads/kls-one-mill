{
  "$schema": "http://cyclonedx.org/schema/bom-1.7.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "metadata": {
    "component": {
      "bom-ref": "overlay:onemill",
      "type": "application",
      "name": "KLS OneMill SBOM overlay",
      "description": "HAND-MAINTAINED fragment merged by vcpkg_to_cyclonedx.py --overlay. It holds only what tooling cannot derive: the commercial SDKs (ModuleWorks, Polygonica) and their bundled PyPy runtime, plus the security-relevant third-party libraries VTK vendors inside its own tree (invisible to vcpkg AND to Syft, because this VTK is a prebuilt external install and its ThirdParty libs are statically linked). This file is reviewed like code. Only `components` and `dependencies` are read by the script; the rest makes it validate standalone. IMPORTANT: the VTK third-party entries are parented under bom-ref 'ext:vtk@9.5' - keep that version in sync with what --cmake-cache derives (the vtk-9.5 suffix of VTK_DIR), and always run the generator WITH --cmake-cache so that node exists."
    }
  },
  "components": [
    {
      "bom-ref": "ext:moduleworks-sdk",
      "type": "library",
      "name": "ModuleWorks SDK",
      "version": "2026.08",
      "supplier": { "name": "ModuleWorks GmbH", "url": ["https://www.moduleworks.com"] },
      "scope": "required",
      "licenses": [{ "license": { "name": "ModuleWorks commercial (proprietary)", "acknowledgement": "declared" } }],
      "purl": "pkg:generic/moduleworks-sdk@2026.08",
      "externalReferences": [{ "type": "website", "url": "https://www.moduleworks.com" }],
      "properties": [
        { "name": "cads:source", "value": "external-toolchain (MODULEWORKS_DIR)" },
        { "name": "cads:commercial", "value": "true" },
        { "name": "cads:vulnSource", "value": "vendor-advisory (no public CPE/purl)" },
        { "name": "cads:verify", "value": "Confirm exact SDK build; repo pins the 2026.08 bin/ layout with mwSupport.lic." }
      ]
    },
    {
      "bom-ref": "ext:pypy",
      "type": "application",
      "name": "PyPy",
      "version": "",
      "supplier": { "name": "The PyPy Team", "url": ["https://www.pypy.org"] },
      "scope": "required",
      "licenses": [{ "license": { "id": "MIT", "acknowledgement": "declared" } }],
      "purl": "pkg:generic/pypy@3.10",
      "externalReferences": [{ "type": "website", "url": "https://www.pypy.org" }],
      "properties": [
        { "name": "cads:source", "value": "ModuleWorks PPFramework (deploy_ppf.exe, PyPy310)" },
        { "name": "cads:pythonCompat", "value": "3.10" },
        { "name": "cads:verify", "value": "Fill the PyPy runtime version (e.g. 7.3.x) from the deployed interpreter, then set version + cpe." },
        { "name": "cads:cpeTemplate", "value": "cpe:2.3:a:pypy:pypy:{version}:*:*:*:*:*:*:*" }
      ]
    },
    {
      "bom-ref": "ext:polygonica",
      "type": "library",
      "name": "Polygonica",
      "version": "",
      "supplier": { "name": "MachineWorks Ltd.", "url": ["https://www.polygonica.com"] },
      "scope": "required",
      "licenses": [{ "license": { "name": "Polygonica commercial (proprietary)", "acknowledgement": "declared" } }],
      "purl": "pkg:generic/polygonica",
      "externalReferences": [{ "type": "website", "url": "https://www.polygonica.com" }],
      "properties": [
        { "name": "cads:source", "value": "external-toolchain (POLYGONICA_DIR, MillingBackend)" },
        { "name": "cads:commercial", "value": "true" },
        { "name": "cads:vulnSource", "value": "vendor-advisory (no public CPE/purl)" },
        { "name": "cads:verify", "value": "Fill the Polygonica SDK version; repo uses the msoft143/dds_ build (pg.lib)." }
      ]
    },

    { "bom-ref": "vtk-thirdparty:zlib", "type": "library", "name": "zlib", "version": "",
      "scope": "required", "supplier": { "name": "zlib" },
      "purl": "pkg:github/madler/zlib",
      "externalReferences": [{ "type": "vcs", "url": "https://github.com/madler/zlib" }],
      "properties": [
        { "name": "cads:source", "value": "VTK vendored ThirdParty" },
        { "name": "cads:verify", "value": "Confirm this VTK build bundles zlib and set its version." },
        { "name": "cads:cpeTemplate", "value": "cpe:2.3:a:zlib:zlib:{version}:*:*:*:*:*:*:*" }
      ] },
