endif()

if(_EN_MILLING)
  copy_module_dll("ModuleMillingKalotte")
  copy_module_config("ModuleMillingKalotte")
  copy_module_release_notes("ModuleMillingKalotte")
  if(_EN_MILLING_DEPS)
    copy_module_subdir("ModuleMillingKalotte" "deps")
  endif()
else()
