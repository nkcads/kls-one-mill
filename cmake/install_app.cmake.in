# install_app.cmake — generated by configure_file from cmake/install_app.cmake.in. Do not edit.
#
# Invoke via add_custom_target with:
#   -DINSTALL_MODE=full|plugins
#   -DAPP_EXE=<path/to/MainApp.exe>          (build output)
#   -DALL_DLLS=<semicolon-list>              (TARGET_RUNTIME_DLLS)
#   -DBUILD_DIR=<path/to/bin/Config>
#   -DCONFIG=Release|Debug|...

cmake_minimum_required(VERSION 3.16)

# ---- Options baked at configure time ----
set(_INSTALL_DIR       "@INSTALL_DIR@")
set(_WINDEPLOYQT       "@WINDEPLOYQT_EXECUTABLE@")
set(_APP_NAME          "@INSTALL_APP_NAME@")
set(_VERSION           "@ONEMILL_VERSION_FULL@")
set(_BUILD_ROOT        "@CMAKE_BINARY_DIR@")

set(_EN_VIEW          @INSTALL_MOD_VIEW@)
set(_EN_OVERLAY       @INSTALL_MOD_OVERLAY@)
set(_EN_MILLING       @INSTALL_MOD_MILLING@)
set(_EN_PP            @INSTALL_MOD_PP@)
set(_EN_STATISTICS    @INSTALL_MOD_STATISTICS@)
set(_EN_REPORTER      @INSTALL_MOD_REPORTER@)
set(_EN_FIXTURE       @INSTALL_MOD_FIXTURE@)
set(_EN_FILETRANSFER  @INSTALL_MOD_FILETRANSFER@)
set(_EN_FITTING       @INSTALL_MOD_FITTING@)
set(_EN_UPDATER       @INSTALL_MOD_UPDATER@)

set(_EN_SHARED_DEPS   @INSTALL_SHARED_DEPS@)
set(_EN_PP_DEPS       @INSTALL_MOD_PP_DEPS@)

# Shared dependency packages and the modules using them (cmake/SharedDeps.cmake):
#   _SHARED_PACKAGES, _SHARED_PACKAGE_USERS_<Package>
@ONEMILL_SHARED_PACKAGE_TABLE@

# ---- Helpers ----

# Adds one of our own binaries, relative to the install root, to the first-party manifest - the
# list signing and the installer work from. Recorded where the file is staged, so the list cannot
# drift from what the tree actually contains; third-party binaries never pass through here.
function(record_first_party REL_PATH)
  file(APPEND "${_MANIFEST}" "${REL_PATH}\n")
endfunction()

function(copy_module_dll MOD_NAME)
  set(_src "${_BUILD_MODULES}/${MOD_NAME}.dll")
  if(EXISTS "${_src}")
    file(COPY "${_src}" DESTINATION "${_INST_MODULES}")
    record_first_party("modulesBert/${MOD_NAME}.dll")
    message(STATUS "  + ${MOD_NAME}.dll")
    # Remembered for the shared-package step at the end, and the module's private deps/
    # are (re)installed right here - every installed module gets them, if it has any.
    set_property(GLOBAL APPEND PROPERTY _INSTALLED_MODULES "${MOD_NAME}")
    copy_module_private_deps("${MOD_NAME}")
  else()
    # Fail fast: a module enabled for install but absent from the build output
    # would otherwise ship as a silently incomplete package (exit code 0).
    message(FATAL_ERROR
      "Install aborted: ${MOD_NAME}.dll is missing.\n"
      "  expected: ${_src}\n"
      "  The module is enabled for install but was not built. Build the 'all' "
      "target first - MainApp does not depend on the plugin DLLs.")
  endif()
endfunction()

function(copy_module_config MOD_NAME)
  set(_src "${_BUILD_MODULES}/${MOD_NAME}/config")
  set(_dst "${_INST_MODULES}/${MOD_NAME}")
  if(INSTALL_MODE STREQUAL "plugins")
    if(EXISTS "${_dst}/config")
      file(REMOVE_RECURSE "${_dst}/config")
      message(STATUS "  ~ cleaned ${MOD_NAME}/config")
    endif()
  endif()
  if(EXISTS "${_src}")
    file(MAKE_DIRECTORY "${_dst}")
    file(COPY "${_src}" DESTINATION "${_dst}")
    message(STATUS "  + ${MOD_NAME}/config")
  endif()
endfunction()

function(copy_module_release_notes MOD_NAME)
  set(_src "${_BUILD_MODULES}/${MOD_NAME}/releaseNotes")
  set(_dst "${_INST_MODULES}/${MOD_NAME}")
  if(EXISTS "${_src}")
    file(MAKE_DIRECTORY "${_dst}")
    file(COPY "${_src}" DESTINATION "${_dst}")
    message(STATUS "  + ${MOD_NAME}/releaseNotes")
  endif()
endfunction()

# Private <Module>/deps (optional - most modules have none). The installed copy is always
# replaced, not merged: an install from before the shared-deps move still holds a full
# ModuleWorks copy in ModuleMillingKalotte/deps and ModulePostProcessor/deps, which would now
# duplicate shared/ModuleWorks (undefined DLL resolution, see MainApp ModuleDllSearchPaths).
function(copy_module_private_deps MOD_NAME)
  set(_src "${_BUILD_MODULES}/${MOD_NAME}/deps")
  set(_dst "${_INST_MODULES}/${MOD_NAME}")
  if(EXISTS "${_dst}/deps")
    file(REMOVE_RECURSE "${_dst}/deps")
  endif()
  if(EXISTS "${_src}")
    file(MAKE_DIRECTORY "${_dst}")
    file(COPY "${_src}" DESTINATION "${_dst}")
    message(STATUS "  + ${MOD_NAME}/deps")
  endif()
endfunction()

# modulesBert/shared/<Package> - replaced as a whole, like a module's deps/.
function(copy_shared_package PACKAGE)
  set(_src "${_BUILD_MODULES}/shared/${PACKAGE}")
  set(_dst "${_INST_MODULES}/shared/${PACKAGE}")
  if(NOT EXISTS "${_src}")
    message(FATAL_ERROR
      "Install aborted: shared dependency package '${PACKAGE}' is missing.
"
      "  expected: ${_src}
"
      "  Build the 'all' target before installing (target SharedDeps_${PACKAGE}).")
  endif()
  if(EXISTS "${_dst}")
    file(REMOVE_RECURSE "${_dst}")
  endif()
  file(MAKE_DIRECTORY "${_INST_MODULES}/shared")
  file(COPY "${_src}" DESTINATION "${_INST_MODULES}/shared")
  message(STATUS "  + shared/${PACKAGE}")
endfunction()

function(copy_module_subdir MOD_NAME SUBDIR)
  set(_src "${_BUILD_MODULES}/${MOD_NAME}/${SUBDIR}")
  set(_dst "${_INST_MODULES}/${MOD_NAME}")
  if(EXISTS "${_src}")
    file(MAKE_DIRECTORY "${_dst}")
    file(COPY "${_src}" DESTINATION "${_dst}")
    message(STATUS "  + ${MOD_NAME}/${SUBDIR}")
  else()
    # Fail fast with a remediation specific to the payload that is missing.
    # This subdir was explicitly requested (INSTALL_MOD_PP_DEPS), so its absence
    # means the package cannot work - the PostProcessor interpreter gap shipped
    # unnoticed for weeks precisely because this was only a warning.
    if(SUBDIR STREQUAL "interpreter")
      set(_hint "The PyPy interpreter was never staged. Run deploy_ppf.exe once in\n      <MODULEWORKS_DIR>/PPFramework/PPFramework, then rebuild:\n        deploy_ppf.exe --no-Config.GUI --Config.OFFLINE --Config.PYPY_TO_INSTALL PyPy310 --Config.DEFAULT_INSTALL_DIR .")
    else()
      set(_hint "Build the 'all' target before installing.")
    endif()
    message(FATAL_ERROR
      "Install aborted: ${MOD_NAME}/${SUBDIR} is missing.\n"
      "  expected: ${_src}\n"
      "  ${_hint}")
  endif()
endfunction()

function(update_version_json)
  set(_cfg_dir  "${_INSTALL_DIR}/config")
  set(_cfg_path "${_cfg_dir}/mainAppConfig.json")
  file(MAKE_DIRECTORY "${_cfg_dir}")

  # Read existing JSON or fall back to a default
  set(_json "")
  if(EXISTS "${_cfg_path}")
    file(READ "${_cfg_path}" _json)
  endif()
  if(_json STREQUAL "")
    set(_json "{\n    \"applicationName\": \"KLSOneMill\",\n    \"showTimestamp\": true,\n    \"version\": \"${_VERSION}\"\n}\n")
  endif()

  # The product version the binaries carry, not a per-tree counter: two trees installed from
  # the same commit must say the same thing. The title bar and every module read it from here.
  string(REGEX MATCH "\"version\"[ \t]*:[ \t]*\"([^\"]*)\"" _m "${_json}")
  if(_m STREQUAL "")
    message(FATAL_ERROR
      "Install aborted: ${_cfg_path} has no \"version\" entry, so the installed version cannot be set.")
  endif()
  set(_ver "${CMAKE_MATCH_1}")
  set(_new_ver "${_VERSION}")

  string(REGEX REPLACE
    "(\"version\"[ \t]*:[ \t]*\")([^\"]*)(\")"
    "\\1${_new_ver}\\3"
    _new_json "${_json}")

  if(NOT "${_APP_NAME}" STREQUAL "")
    string(REGEX REPLACE
      "(\"applicationName\"[ \t]*:[ \t]*\")([^\"]*)(\")"
      "\\1${_APP_NAME}\\3"
      _new_json "${_new_json}")
  endif()

  file(WRITE "${_cfg_path}" "${_new_json}")
  message(STATUS "[+] config/mainAppConfig.json  (${_ver} → ${_new_ver})")
endfunction()

# ---- Validate inputs ----

if(NOT DEFINED INSTALL_MODE OR INSTALL_MODE STREQUAL "")
  message(FATAL_ERROR "INSTALL_MODE must be 'full' or 'plugins'")
endif()
if(NOT DEFINED BUILD_DIR OR NOT EXISTS "${BUILD_DIR}")
  message(FATAL_ERROR "BUILD_DIR not set or does not exist: '${BUILD_DIR}'")
endif()

set(_BUILD_MODULES "${BUILD_DIR}/modulesBert")
set(_INST_MODULES  "${_INSTALL_DIR}/modulesBert")

# One manifest per product, in the build tree so it never ships, rewritten on every run so a
# module that was switched off drops out of it.
if("${_APP_NAME}" STREQUAL "")
  set(_product "KLSOneMill")
else()
  set(_product "${_APP_NAME}")
endif()
set(_MANIFEST "${_BUILD_ROOT}/first-party/${_product}.txt")
file(MAKE_DIRECTORY "${_BUILD_ROOT}/first-party")
file(WRITE "${_MANIFEST}" "")

message(STATUS "")
message(STATUS "=== KLSOneMill install [${INSTALL_MODE}] ===")
message(STATUS "Destination : ${_INSTALL_DIR}")
message(STATUS "Build dir   : ${BUILD_DIR}")
message(STATUS "")

# ---- FULL: exe + Qt + VTK runtime ----
if(INSTALL_MODE STREQUAL "full")
  if(NOT DEFINED APP_EXE OR NOT EXISTS "${APP_EXE}")
    message(FATAL_ERROR "APP_EXE not found: '${APP_EXE}'")
  endif()

  file(MAKE_DIRECTORY "${_INSTALL_DIR}")

  # 1) Copy exe
  file(COPY "${APP_EXE}" DESTINATION "${_INSTALL_DIR}")
  get_filename_component(_exe_name "${APP_EXE}" NAME)
  record_first_party("${_exe_name}")
  message(STATUS "[+] ${_exe_name}")

  if(DEFINED UPDATER_EXE AND EXISTS "${UPDATER_EXE}")
    file(COPY "${UPDATER_EXE}" DESTINATION "${_INSTALL_DIR}")
    record_first_party("Updater.exe")
    message(STATUS "[+] Updater.exe")
  else()
    message(FATAL_ERROR
      "Install aborted: Updater.exe is missing.\n"
      "  expected: ${UPDATER_EXE}\n"
      "  Build the 'all' target before installing.")
  endif()

  # 2) windeployqt
  set(_inst_exe "${_INSTALL_DIR}/${_exe_name}")
  if(CONFIG STREQUAL "Debug")
    set(_qt_flag "--debug")
  else()
    set(_qt_flag "--release")
  endif()

  execute_process(
    COMMAND "${_WINDEPLOYQT}" ${_qt_flag}
            --no-translations --no-quick-import
            --no-system-d3d-compiler --no-compiler-runtime
            --dir "${_INSTALL_DIR}" "${_inst_exe}"
    RESULT_VARIABLE _rc
    ERROR_VARIABLE  _err
    OUTPUT_VARIABLE _out
  )
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "windeployqt failed:\n${_err}")
  endif()
  message(STATUS "[+] Qt runtime (windeployqt)")

  # 3) Runtime DLLs from linked targets (VTK etc.)
  set(_dlls ${ALL_DLLS})
  list(REMOVE_DUPLICATES _dlls)
  set(_n 0)
  foreach(_d IN LISTS _dlls)
    if(EXISTS "${_d}")
      file(COPY "${_d}" DESTINATION "${_INSTALL_DIR}")
      math(EXPR _n "${_n} + 1")
    endif()
  endforeach()
  message(STATUS "[+] ${_n} runtime DLLs (VTK + linked libs)")

elseif(INSTALL_MODE STREQUAL "plugins")
  # plugins-only — install dir must already exist with a running deployment
  if(NOT EXISTS "${_INSTALL_DIR}")
    message(FATAL_ERROR "Install directory does not exist: ${_INSTALL_DIR}\nRun install_full first.")
  endif()

  # Copy exe if build output is newer than installed copy
  if(DEFINED APP_EXE AND EXISTS "${APP_EXE}")
    get_filename_component(_exe_name "${APP_EXE}" NAME)
    set(_inst_exe "${_INSTALL_DIR}/${_exe_name}")
    set(_do_copy TRUE)
    if(EXISTS "${_inst_exe}")
      file(TIMESTAMP "${APP_EXE}"   _src_ts "%s" UTC)
      file(TIMESTAMP "${_inst_exe}" _dst_ts "%s" UTC)
      if(NOT _src_ts GREATER _dst_ts)
        set(_do_copy FALSE)
      endif()
    endif()
    if(_do_copy)
      file(COPY "${APP_EXE}" DESTINATION "${_INSTALL_DIR}")
      message(STATUS "[+] ${_exe_name} (updated)")
    else()
      message(STATUS "[ ] ${_exe_name} (up to date)")
    endif()
    # Part of the tree either way - the manifest lists what is installed, not what was copied.
    record_first_party("${_exe_name}")
  endif()

  # Copy Updater.exe if the build output is newer than the installed copy
  if(DEFINED UPDATER_EXE AND EXISTS "${UPDATER_EXE}")
    set(_inst_updater "${_INSTALL_DIR}/Updater.exe")
    set(_do_copy_updater TRUE)
    if(EXISTS "${_inst_updater}")
      file(TIMESTAMP "${UPDATER_EXE}"   _updater_src_ts "%s" UTC)
      file(TIMESTAMP "${_inst_updater}" _updater_dst_ts "%s" UTC)
      if(NOT _updater_src_ts GREATER _updater_dst_ts)
        set(_do_copy_updater FALSE)
      endif()
    endif()
    if(_do_copy_updater)
      file(COPY "${UPDATER_EXE}" DESTINATION "${_INSTALL_DIR}")
      message(STATUS "[+] Updater.exe (updated)")
    else()
      message(STATUS "[ ] Updater.exe (up to date)")
    endif()
    record_first_party("Updater.exe")
  endif()
else()
  message(FATAL_ERROR "Unknown INSTALL_MODE '${INSTALL_MODE}'. Use 'full' or 'plugins'.")
endif()

# ---- Version ----
update_version_json()

# ---- Release Notes ----
set(_rn_src "@CMAKE_SOURCE_DIR@/releaseNotes")
if(EXISTS "${_rn_src}")
  file(COPY "${_rn_src}" DESTINATION "${_INSTALL_DIR}")
  message(STATUS "[+] releaseNotes/")
endif()

# ---- Modules ----
file(MAKE_DIRECTORY "${_INST_MODULES}")
message(STATUS "Modules:")

if(_EN_VIEW)
  copy_module_dll("ModuleView")
  copy_module_config("ModuleView")
  copy_module_release_notes("ModuleView")
else()
  message(STATUS "  - ModuleView (disabled)")
endif()

if(_EN_OVERLAY)
  copy_module_dll("ModuleOverlayCritter")
  copy_module_config("ModuleOverlayCritter")
  copy_module_release_notes("ModuleOverlayCritter")
else()
  message(STATUS "  - ModuleOverlayCritter (disabled)")
endif()

if(_EN_MILLING)
  copy_module_dll("ModuleMillingKalotte")
  copy_module_config("ModuleMillingKalotte")
  copy_module_release_notes("ModuleMillingKalotte")
else()
  message(STATUS "  - ModuleMillingKalotte (disabled)")
endif()

if(_EN_PP)
  copy_module_dll("ModulePostProcessor")
  copy_module_config("ModulePostProcessor")
  copy_module_release_notes("ModulePostProcessor")
  if(_EN_PP_DEPS)
    copy_module_subdir("ModulePostProcessor" "interpreter")
  endif()
else()
  message(STATUS "  - ModulePostProcessor (disabled)")
endif()

if(_EN_STATISTICS)
  copy_module_dll("ModuleStatistics")
  copy_module_config("ModuleStatistics")
  copy_module_release_notes("ModuleStatistics")
else()
  message(STATUS "  - ModuleStatistics (disabled)")
endif()

if(_EN_REPORTER)
  copy_module_dll("ModuleReporter")
  copy_module_config("ModuleReporter")
  copy_module_release_notes("ModuleReporter")
else()
  message(STATUS "  - ModuleReporter (disabled)")
endif()

if(_EN_FIXTURE)
  copy_module_dll("ModuleFixture")
  copy_module_config("ModuleFixture")
  copy_module_release_notes("ModuleFixture")
else()
  message(STATUS "  - ModuleFixture (disabled)")
endif()

if(_EN_FILETRANSFER)
  copy_module_dll("ModuleFileTransfer")
  copy_module_config("ModuleFileTransfer")
  copy_module_release_notes("ModuleFileTransfer")
else()
  message(STATUS "  - ModuleFileTransfer (disabled)")
endif()

if(_EN_FITTING)
  copy_module_dll("ModuleFittingAnalysis")
  copy_module_config("ModuleFittingAnalysis")
  copy_module_release_notes("ModuleFittingAnalysis")
else()
  message(STATUS "  - ModuleFittingAnalysis (disabled)")
endif()

if(_EN_UPDATER)
  copy_module_dll("ModuleUpdater")
  copy_module_config("ModuleUpdater")
  copy_module_release_notes("ModuleUpdater")
else()
  message(STATUS "  - ModuleUpdater (disabled)")
endif()

# ---- Shared dependency packages ----
# Installed when at least one installed module uses the package - derived, no per-module option.
get_property(_installed_modules GLOBAL PROPERTY _INSTALLED_MODULES)
message(STATUS "Shared dependency packages:")
foreach(_pkg IN LISTS _SHARED_PACKAGES)
  set(_needed FALSE)
  foreach(_user IN LISTS _SHARED_PACKAGE_USERS_${_pkg})
    if(_user IN_LIST _installed_modules)
      set(_needed TRUE)
    endif()
  endforeach()

  if(NOT _needed)
    message(STATUS "  - shared/${_pkg} (no installed module uses it)")
  elseif(NOT _EN_SHARED_DEPS)
    message(STATUS "  - shared/${_pkg} (INSTALL_SHARED_DEPS=OFF)")
  else()
    copy_shared_package("${_pkg}")
  endif()
endforeach()

file(STRINGS "${_MANIFEST}" _first_party)
list(LENGTH _first_party _first_party_count)
message(STATUS "")
message(STATUS "First-party manifest: ${_MANIFEST} (${_first_party_count} binaries)")

message(STATUS "")
message(STATUS "=== Done ===")
